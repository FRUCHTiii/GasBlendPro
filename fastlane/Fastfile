# Fastfile for Gas Blend Pro

require "shellwords"

default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    version_number = ENV["VERSION_NUMBER"].to_s
    build_number = ENV["BUILD_NUMBER"].to_s
    unless version_number.match?(/\A\d+\.\d+\.\d+\z/)
      raise ArgumentError, "VERSION_NUMBER must be a release version such as 1.3.0"
    end
    unless build_number.match?(/\A[1-9]\d*(?:\.\d+){0,2}\z/)
      raise ArgumentError, "BUILD_NUMBER must be a numeric build version such as 42.1"
    end

    # Create API Key for App Store Connect
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY"],
      is_key_content_base64: true
    )

    # Apply CI versions to the archive without editing the checked-in project.
    build_app(
      scheme: "GasBlendPro",
      configuration: "Release",
      export_method: "app-store",
      codesigning_identity: "Apple Distribution",
      export_xcargs: "-allowProvisioningUpdates",
      xcargs: Shellwords.join([
        "CODE_SIGN_STYLE=Manual",
        "PROVISIONING_PROFILE_SPECIFIER=#{ENV['PROVISIONING_PROFILE_SPECIFIER']}",
        "DEVELOPMENT_TEAM=#{ENV['APPLE_TEAM_ID']}",
        "MARKETING_VERSION=#{version_number}",
        "CURRENT_PROJECT_VERSION=#{build_number}"
      ]),
      export_options: {
        method: "app-store",
        manageAppVersionAndBuildNumber: false,
        teamID: ENV["APPLE_TEAM_ID"],
        provisioningProfiles: {
          "de.werk4-services.GasBlendPro" => ENV["PROVISIONING_PROFILE_SPECIFIER"]
        }
      }
    )

    # Upload to TestFlight
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
