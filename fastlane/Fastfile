# Fastfile for Gas Blend Pro

default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    # Create API Key for App Store Connect
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY"],
      is_key_content_base64: true
    )

    # Increment build number
    increment_build_number(
      build_number: ENV["BUILD_NUMBER"],
      xcodeproj: "GasBlendPro.xcodeproj"
    )

    # Update version number
    increment_version_number(
      version_number: ENV["VERSION_NUMBER"],
      xcodeproj: "GasBlendPro.xcodeproj"
    )

    # Build the app
    build_app(
      scheme: "GasBlendPro",
      configuration: "Release",
      export_method: "app-store",
      codesigning_identity: "Apple Distribution",
      export_xcargs: "-allowProvisioningUpdates",
      xcargs: "CODE_SIGN_STYLE=Manual PROVISIONING_PROFILE_SPECIFIER='#{ENV['PROVISIONING_PROFILE_SPECIFIER']}' DEVELOPMENT_TEAM='#{ENV['APPLE_TEAM_ID']}'",
      export_options: {
        method: "app-store",
        teamID: ENV["APPLE_TEAM_ID"],
        provisioningProfiles: {
          "de.werk4-services.GasBlendPro" => ENV["PROVISIONING_PROFILE_SPECIFIER"]
        }
      }
    )

    # Upload to TestFlight
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
